# Next.js web env template.
# Copy this file into:
# - .env.development
# - .env.production
#
# Only public browser-safe values belong here.
# Server-only allowlists like PROMPTOPS_ADMIN_EMAILS are also read by Next.js
# on the server, but should be set per environment and never exposed in the UI.
# PORT is used by the local `npm run dev` wrapper so parallel worktrees do not
# accidentally collide on the same Next.js port.

PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
PROMPTOPS_ADMIN_EMAILS=admin@example.com
PROMPTOPS_DEV_BYPASS=false
