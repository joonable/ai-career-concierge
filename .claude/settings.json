{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/codex-plan-review.sh\"",
            "timeout": 300,
            "statusMessage": "Codex plan review 실행 중..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git checkout*)",
            "command": "echo 'Prefer scripts/start_agent_task.sh or scripts/start_integration_task.sh so branch/worktree rules stay aligned with main.'",
            "statusMessage": "Git 시작 규칙 안내"
          },
          {
            "type": "command",
            "if": "Bash(git switch*)",
            "command": "echo 'Prefer scripts/start_agent_task.sh or scripts/start_integration_task.sh so branch/worktree rules stay aligned with main.'",
            "statusMessage": "Git 시작 규칙 안내"
          },
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "branch=$(git branch --show-current); case \"$branch\" in main|'') echo '[guard] BLOCKED: main에 직접 커밋 금지.' >&2; echo 'scripts/start_agent_task.sh --agent claude --task <slug> 으로 worktree를 먼저 만드세요.' >&2; exit 2 ;; codex/*|claude/*|gemini/*|integration/*) echo \"[guard] OK: branch $branch\" ;; *) echo \"[guard] WARNING: 비표준 브랜치 $branch. 의도적인 경우 계속 진행합니다.\" ;; esac",
            "timeout": 30,
            "statusMessage": "PreCommit: branch 규칙 점검 중..."
          },
          {
            "type": "command",
            "if": "Bash(git push*origin*main*)",
            "command": "echo '[guard] BLOCKED: main에 직접 push 금지. PR을 통해 merge하세요.' >&2; exit 2",
            "timeout": 10,
            "statusMessage": "PrePush: main 직접 push 차단 중..."
          },
          {
            "type": "command",
            "if": "Bash(scripts/start_agent_task.sh*)",
            "command": "echo 'Using main-based agent worktree flow.'",
            "statusMessage": "Agent worktree 시작"
          },
          {
            "type": "command",
            "if": "Bash(scripts/start_integration_task.sh*)",
            "command": "echo 'Using main-based integration worktree flow.'",
            "statusMessage": "Integration worktree 시작"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "python3 scripts/implementation_docs.py validate 2>&1 && cd apps/web && npx tsc --noEmit 2>&1 | head -30 && poetry run pytest tests/unit -x -q --tb=short 2>&1 | tail -20",
            "timeout": 120,
            "statusMessage": "PreCommit: docs validate + tsc + pytest 실행 중..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "echo 'docs/internal/status.md 업데이트 필요 여부를 확인하세요.'",
            "statusMessage": "PostCommit: 상태판 업데이트 리마인더"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/save-plan-stop.sh\"",
            "statusMessage": "StopHook: plan package 저장 확인 중..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(scripts/start_agent_task.sh*)",
      "Bash(scripts/start_integration_task.sh*)",
      "Bash(poetry run pytest*)",
      "Bash(poetry run dev*)",
      "Bash(poetry run eval-jobs*)",
      "Bash(cd apps/web && npm*)",
      "Bash(cd apps/web && npx*)",
      "Bash(python3 scripts/implementation_docs.py*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)"
    ]
  }
}
