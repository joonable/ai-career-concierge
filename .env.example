# Backend env template.
# Copy this file into environment-specific files such as:
# - .env.development
# - .env.production
#
# Never reuse dev credentials in prod.

APP_ENV=development
APP_DEBUG=true

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
INTERNAL_API_KEY=replace-me
# Optional for local login/profile/dashboard development.
# Required for Alembic migrations and the current pipeline ORM path.
DATABASE_URL=postgresql+psycopg://postgres:<SUPABASE_DB_PASSWORD>@db.<SUPABASE_PROJECT_REF>.supabase.co:5432/postgres

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required for backend persistence through the Supabase Data API.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_URL=
SLACK_ALERTS_CHANNEL=#system-alerts

# LLM
GEMINI_API_KEY=

# Observability
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-career-concierge-dev

# Scheduling
PIPELINE_ENABLED=false
ALLOW_DEV_SCHEDULE=false
