# Backend env template.
# Copy this file into environment-specific files such as:
# - .env.development
# - .env.production
#
# Never reuse dev credentials in prod.

APP_ENV=development
APP_DEBUG=true

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
INTERNAL_API_KEY=replace-me
WEB_ORIGIN=http://localhost:3000
# Legacy optional value for direct Postgres tooling only.
DATABASE_URL=postgresql+psycopg://postgres:<SUPABASE_DB_PASSWORD>@db.<SUPABASE_PROJECT_REF>.supabase.co:5432/postgres

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required for backend persistence through the Supabase Data API.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_URL=
SLACK_ALERTS_CHANNEL=#system-alerts

# LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Observability
# Leave blank to disable LangSmith tracing in local/dev environments.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-career-concierge-dev
LANGSMITH_EVAL_PROMPT_IDENTIFIER=
LANGSMITH_EVAL_PROMPT_NAME=job-evaluation
LANGSMITH_EVAL_PROMPT_VERSION=local-v1
LANGSMITH_EVAL_PROMPT_VARIANT=default
LANGSMITH_MEMORY_PROMPT_IDENTIFIER=
LANGSMITH_MEMORY_PROMPT_NAME=memory-summary
LANGSMITH_MEMORY_PROMPT_VERSION=local-v1
LANGSMITH_MEMORY_PROMPT_VARIANT=default
LANGSMITH_EVAL_DATASET_NAME=job-eval-gold-dev
PIPELINE_VERSION=v1

# Scheduling
PIPELINE_ENABLED=false
ALLOW_DEV_SCHEDULE=false

# Scraper
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT_MS=15000
SCRAPER_MAX_PAGES=2
SCRAPER_INCRUIT_BASE_URL=https://job.incruit.com
